# This is a shared gitconfig. The idea is that this can be included by other hosts
# by referencing this file in their global config:
#[include]
#    path = ~/.gitconfig-common

[user]
	name = Aristeo Montoya
    # email -> Define in global config
    # signingkey -> Define in global config

[core]
	editor = nvim
	pager = delta

[init]
	defaultBranch = master

[interactive]
	diffFilter = delta --color-only

[delta]
	true-color = always
	navigate = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[push]
	autoSetupRemote = true

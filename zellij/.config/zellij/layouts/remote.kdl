// Same as default.kdl, but with the status bar first (top) instead of last
// (bottom) — used by zellij_attach_last (zsh-functions) when creating a
// session on a host we SSH'd into, mirroring tmux.remote.conf's
// `set -g status-position top`.
layout {
    pane size=1 borderless=true {
        plugin location="zjstatus"
    }
    pane
}
